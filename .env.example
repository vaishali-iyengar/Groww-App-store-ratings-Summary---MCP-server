# ---------------------------------------------------------------------------
# google-workspace-mcp configuration. Copy to .env (never commit .env).
# Empty values are treated as unset.
# ---------------------------------------------------------------------------

# --- Google OAuth 2.0 (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Loopback redirect used by `npm run auth`. For HTTP mode, the server's callback is
# ${MCP_PUBLIC_BASE_URL}/oauth2/callback — register both in the Cloud Console.
GOOGLE_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback
# Defaults to: gmail.send documents openid email (narrowest scopes for the MVP).
GOOGLE_OAUTH_SCOPES=
# Must be true to request scopes outside the MVP set (e.g. https://mail.google.com/).
ALLOW_BROAD_SCOPES=false

# --- Token storage ---
# At least 32 characters. Generate with: openssl rand -base64 32
TOKEN_STORE_ENCRYPTION_KEY=
# Where encrypted tokens, idempotency records and the audit log live (default ~/.config/google-workspace-mcp).
DATA_DIR=

# --- MCP server ---
MCP_SERVER_NAME=google-workspace-mcp
MCP_SERVER_VERSION=1.0.0
# underscore (gmail_send_email — works with every host) or dotted (gmail.send_email — spec names).
TOOL_NAME_STYLE=underscore
# Google account slot used in stdio (single-user) mode.
DEFAULT_USER_ID=default

# --- Logging (JSON lines on stderr) ---
LOG_LEVEL=info
# How recipient addresses appear in logs and audit records: hash | mask | plain
LOG_RECIPIENTS=hash

# --- Limits ---
MAX_EMAIL_RECIPIENTS=20
MAX_EMAIL_BODY_BYTES=1000000
MAX_EMAIL_SUBJECT_CHARS=500
MAX_DOC_APPEND_BYTES=1000000
IDEMPOTENCY_TTL_SECONDS=86400
# Identical requests without an idempotency_key are suppressed within this window (0 disables).
AUTO_DEDUPE_WINDOW_SECONDS=60
# IANA time zone for google_docs.append timestamps.
TIMESTAMP_TIMEZONE=UTC

# --- Policy (optional JSON file; see examples/policy.example.json) ---
POLICY_FILE=

# --- Remote mode (npm run start:http) ---
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
# Public https URL the server is reachable at (used for the OAuth callback).
MCP_PUBLIC_BASE_URL=
# Comma-separated "<userId>:<sha256(token)>" entries. Generate with: npm run hash-token -- <userId>
MCP_HTTP_TOKEN_HASHES=
# Allowed browser Origin hostnames (non-browser MCP clients send no Origin).
MCP_HTTP_ALLOWED_ORIGINS=
MCP_HTTP_RATE_LIMIT_PER_MINUTE=60
# Signs OAuth state parameters; at least 32 characters (random per process if unset).
OAUTH_STATE_SECRET=
